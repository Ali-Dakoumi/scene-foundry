AI_PROVIDER=openrouter
AI_INCLUDE_GEMINI=false

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_VIDEO_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_VIDEO_FALLBACK_MODEL=

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=

# Paid ChatGPT/OpenAI fallback after free OpenRouter quota. Do not commit this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

LLM_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_RETRIES_PER_PROVIDER=2
AI_CACHE_TTL_MS=600000

# Optional; increases GitHub API rate limits for repository ingestion.
GITHUB_TOKEN=
# Optional override; Windows automatically uses installed Chrome or Edge.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require&connect_timeout=30
FRONTEND_ORIGIN=http://localhost:5173
PORT=3000
