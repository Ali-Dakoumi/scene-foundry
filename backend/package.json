{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:init:windows": "node --experimental-sqlite scripts/init-sqlite.cjs",
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Multi-agent WebGL scene generator API",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.3.5",
    "@langchain/google-genai": "^2.3.4",
    "@langchain/langgraph": "^1.7.1",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^6.19.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "puppeteer": "^25.16.0",
    "puppeteer-screen-recorder": "^3.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
